{
  "expo": {
    "name": "Exercise Timer",
    "slug": "timer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "exercisetimer",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0f172a",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0f172a"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.exercisetimer.app"
    },
    "android": {
      "package": "com.exercisetimer.app",
      "adaptiveIcon": {
        "backgroundColor": "#0f172a",
        "foregroundImage": "./assets/adaptive-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Exercise Timer",
      "themeColor": "#0f172a",
      "backgroundColor": "#0f172a",
      "display": "standalone"
    },
    "extra": {
      "eas": {
        "projectId": "92fc5a74-2a57-4758-aed8-69c92918a91c"
      }
    },
    "owner": "sukake-team"
  }
}
